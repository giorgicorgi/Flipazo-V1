{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index-v2",      "destination": "/", "permanent": true },
    { "source": "/index-v2.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/b18d9ae0f353b8f3b3b91546ee319570.txt",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/awin-verify",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/3b1fa13b0f80cf697ef930ea6046de01",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [
    { "source": "/threads",   "destination": "https://api.flipazo.es/go/threads" },
    { "source": "/instagram", "destination": "https://api.flipazo.es/go/instagram" },
    { "source": "/tiktok",    "destination": "https://api.flipazo.es/go/tiktok" },
    { "source": "/youtube",   "destination": "https://api.flipazo.es/go/youtube" },
    { "source": "/go/:slug",       "destination": "https://api.flipazo.es/go/:slug" },
    { "source": "/go-stats/:slug", "destination": "https://api.flipazo.es/go-stats/:slug" },
    { "source": "/blog/(.*)",   "destination": "/blog.html" },
    { "source": "/blog",        "destination": "/blog.html" },
    { "source": "/sobre",       "destination": "/sobre.html" },
    { "source": "/faq",         "destination": "/faq.html" },
    { "source": "/cupones",     "destination": "/cupones.html" },
    { "source": "/cuenta",      "destination": "/cuenta.html" },
    { "source": "/mis-links",   "destination": "/mis-links.html" },
    { "source": "/3b1fa13b0f80cf697ef930ea6046de01.html", "destination": "/awin-verify" },
    { "source": "/3b1fa13b0f80cf697ef930ea6046de01",      "destination": "/awin-verify" }
  ]
}
