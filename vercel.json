{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "flipazo.es" }],
      "destination": "https://www.flipazo.es/$1",
      "permanent": true
    },
    { "source": "/index-v2",      "destination": "/", "permanent": true },
    { "source": "/index-v2.html", "destination": "/", "permanent": true },
    { "source": "/blog/que-es-un-chollo-de-verdad", "destination": "/blog/como-saber-si-una-oferta-es-real", "permanent": true },
    { "source": "/blog/que-significa-descuento-real", "destination": "/blog/como-saber-si-una-oferta-es-real", "permanent": true },
    { "source": "/blog/precio-referencia-vs-precio-real", "destination": "/blog/por-que-ponen-el-precio-tachado", "permanent": true },
    { "source": "/blog/compre-productos-vendi-wallapop-esto-gane", "destination": "/blog/como-saber-si-una-oferta-es-real", "permanent": true },
    { "source": "/blog/mejores-canales-ofertas-espana-2025", "destination": "/blog/ofertas-en-espana-hoy", "permanent": true },
    { "source": "/blog/ofertas-que-desaparecen-en-horas", "destination": "/blog/efecto-black-friday-como-suben-precios", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/b18d9ae0f353b8f3b3b91546ee319570.txt",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/awin-verify",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/3b1fa13b0f80cf697ef930ea6046de01",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [
    { "source": "/threads",   "destination": "https://api.flipazo.es/go/threads" },
    { "source": "/instagram", "destination": "https://api.flipazo.es/go/instagram" },
    { "source": "/tiktok",    "destination": "https://api.flipazo.es/go/tiktok" },
    { "source": "/youtube",   "destination": "https://api.flipazo.es/go/youtube" },
    { "source": "/go/:slug",       "destination": "https://api.flipazo.es/go/:slug" },
    { "source": "/h/:slug",        "destination": "https://api.flipazo.es/go/h-:slug" },
    { "source": "/go-stats/:slug", "destination": "https://api.flipazo.es/go-stats/:slug" },
    { "source": "/blog/(.*)",   "destination": "/blog.html" },
    { "source": "/blog",        "destination": "/blog.html" },
    { "source": "/sobre",       "destination": "/sobre.html" },
    { "source": "/faq",         "destination": "/faq.html" },
    { "source": "/cupones",     "destination": "/cupones.html" },
    { "source": "/cuenta",      "destination": "/cuenta.html" },
    { "source": "/mis-links",   "destination": "/mis-links.html" },
    { "source": "/desde-threads", "destination": "/desde-threads.html" },
    { "source": "/menos-de-15",   "destination": "/" },
    { "source": "/menos-de-25",   "destination": "/" },
    { "source": "/3b1fa13b0f80cf697ef930ea6046de01.html", "destination": "/awin-verify" },
    { "source": "/3b1fa13b0f80cf697ef930ea6046de01",      "destination": "/awin-verify" }
  ]
}
