{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/blog/:slug*", "destination": "/blog.html" },
    { "source": "/blog",        "destination": "/blog.html" },
    { "source": "/sobre",       "destination": "/sobre.html" },
    { "source": "/cuenta",      "destination": "/cuenta.html" }
  ]
}
